# ICS URL
PROTON_ICS_URL=https://example.com/api/calendar/123xyz.ics

# This is the date that your first pay period ENDED
PAST_PAY_PERIOD=2026-09-15

# This is your pay information
HOURLY_RATE=00.00
PAY_PERIOD_TYPE=biweekly    # daily, weekly, biweekly, monthly
DAYS_BETWEEN_PAY_PERIOD_AND_PAYDAY=7    # How many days are between when your pay period ends and when you get your check
AVG_TIPS=00.00              # Put 0 if you do not recieve tips

# Timezone
TIMEZONE=America/New_York   #Examples: America/New_York, America/Chicago, America/Denver, America/Phoenix, America/Los_Angeles

### EXPORT VARIABLES ###

DEST_TYPE="gsheets"         # gsheets | xlsx | ods
DEST_SPREADSHEET="<sheet ID or full URL>"           # xlsx/ods: absolute file path instead
DEST_SHEET="Sheet1"         # tab name (optional; defaults to first/active tab)
DEST_CELL="B2"          # top-left target cell
GOOGLE_CREDENTIALS="/path/to/service-account.json"          # gsheets only